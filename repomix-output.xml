                    icon: const Icon(Icons.add_circle_outline, size: 14, color: Colors.orangeAccent),
                    label: const Text("New Manual", style: TextStyle(color: Colors.orangeAccent, fontSize: 11)),
                  )
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}
