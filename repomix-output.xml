<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pharoah ERP - Enterprise Cloud Web Shell</title>
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <meta name="theme-color" content="#0d47a1">
    <link rel="stylesheet" href="style.css?v=9.0">
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(rList => {
          for (let reg of rList) reg.unregister();
        });
      }
      if ('caches' in window) {
        caches.keys().then(names => {
          for (let n of names) caches.delete(n);
        });
      }
    </script>
</head>
<body>

    <!-- Header -->
    <header class="app-header">
        <div class="brand-box">
            <div>
                <div class="brand-title" id="headerCompanyName">PHAROAH ERP</div>
                <div class="brand-badges">
                    <span id="headerCompanyId" style="color: rgba(255,255,255,0.75);">ID: PH-C-101</span>
                    <span style="opacity: 0.5;">|</span>
                    <span id="headerFyLabel">FY: 2026-27</span>
                    <span class="tag-badge" id="headerBusinessType">WHOLESALE</span>
                </div>
            </div>
        </div>

        <div class="header-actions">
            <div id="syncStatus" class="sync-badge" onclick="openDriveSettings()" title="Google Drive Sync">
                <span class="dot"></span>
                <span id="tenantLabel">Cloud: Active</span>
            </div>
            <button class="btn-icon" onclick="openDriveSettings()" title="Drive Settings">⚙️</button>
            <button class="btn-icon" onclick="openGuideModal()" title="User Manual">📖</button>
        </div>
    </header>

    <!-- Main Workspace -->
    <main>
        <!-- ========================================== -->
        <!-- VIEW 1: DASHBOARD                          -->
        <!-- ========================================== -->
        <section id="view-dashboard">
            <div class="kpi-row">
                <div class="kpi-card">
                    <div class="kpi-card-header">
                        <span class="kpi-label">TODAY SALE</span>
                        <span class="pill" style="color: var(--accent-emerald);">LIVE</span>
                    </div>
                    <div class="kpi-amount" id="kpi-sale">₹ 0.00</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-card-header">
                        <span class="kpi-label">TODAY PURCHASE</span>
                        <span class="pill" style="color: var(--accent-orange);">INWARD</span>
                    </div>
                    <div class="kpi-amount" id="kpi-pur">₹ 0.00</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-card-header">
                        <span class="kpi-label">ESTIMATED STOCK VALUE</span>
                        <span class="pill" style="color: #818cf8;">TAXABLE</span>
                    </div>
                    <div class="kpi-amount" id="kpi-stock">₹ 0.00</div>
                </div>
            </div>

            <!-- Quick Big Buttons -->
            <div class="quick-btn-row">
                <div class="big-btn btn-sale-bg" onclick="startSaleWorkflow()">
                    <span style="font-size: 1.5rem;">🛒</span>
                    <span class="big-btn-text">NEW SALE</span>
                </div>
                <div class="big-btn btn-pur-bg" onclick="showScreen('view-purchases'); initNewPurchaseSession();">
                    <span style="font-size: 1.5rem;">📥</span>
                    <span class="big-btn-text">PURCHASE</span>
                </div>
            </div>

            <!-- Master Hub Banner -->
            <div class="master-banner" onclick="showScreen('view-masters')">
                <span style="font-size: 2rem;">⭐</span>
                <div class="banner-content">
                    <div class="banner-heading">MASTER HUB</div>
                    <div class="banner-subtext">Manage Products, Parties, Companies & Salts</div>
                </div>
                <span>➔</span>
            </div>

            <!-- 9 Business Modules Grid -->
            <div class="module-grid-9">
                <div class="grid-item" onclick="showScreen('view-billing-hub')">
                    <div class="grid-icon blue-icon">🧾</div>
                    <div class="grid-name">BILLING</div>
                </div>
                <div class="grid-item" onclick="showScreen('view-challans')">
                    <div class="grid-icon teal-icon">🚚</div>
                    <div class="grid-name">CHALLANS</div>
                </div>
                <div class="grid-item" onclick="showScreen('view-returns')">
                    <div class="grid-icon red-icon">🔄</div>
                    <div class="grid-name">RETURNS</div>
                </div>
                <div class="grid-item" onclick="showScreen('view-stock')">
                    <div class="grid-icon purple-icon">📊</div>
                    <div class="grid-name">INVENTORY</div>
                </div>
                <div class="grid-item" onclick="showScreen('view-accounts')">
                    <div class="grid-icon blue-icon">💰</div>
                    <div class="grid-name">ACCOUNTS</div>
                </div>
                <div class="grid-item" onclick="showScreen('view-masters')">
                    <div class="grid-icon orange-icon">⭐</div>
                    <div class="grid-name">MASTERS</div>
                </div>
                <div class="grid-item" onclick="showScreen('view-daybook')">
                    <div class="grid-icon bluegrey-icon">📅</div>
                    <div class="grid-name">DAYBOOK</div>
                </div>
                <div class="grid-item" onclick="showScreen('view-ledgers')">
                    <div class="grid-icon green-icon">📑</div>
                    <div class="grid-name">LEDGERS</div>
                </div>
                <div class="grid-item" onclick="openDriveSettings()">
                    <div class="grid-icon teal-icon">☁️</div>
                    <div class="grid-name">CLOUD SYNC</div>
                </div>
            </div>
        </section>

        <!-- ============================================================== -->
        <!-- VIEW: BILLING HUB (5 SUB-ACTIONS)                              -->
        <!-- ============================================================== -->
        <section id="view-billing-hub" style="display: none;">
            <div class="screen-panel">
                <div class="screen-header">
                    <div class="screen-title">BILLING & TRANSACTIONS</div>
                    <button class="btn btn-secondary" onclick="returnToDashboard()">← DASHBOARD</button>
                </div>

                <div class="sub-module-grid-5">
                    <div class="sub-action-card" onclick="startSaleWorkflow()">
