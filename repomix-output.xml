    final String webhookUrl = ph.config.smtpHost.startsWith("http") 
        ? ph.config.smtpHost 
        : "";
    final String email = ph.activeCompany?.email ?? "";

    if (webhookUrl.isNotEmpty && email.isNotEmpty) {
