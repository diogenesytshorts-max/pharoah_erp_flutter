              BillItem i = entry as BillItem;
              int idx = ret.items.indexOf(i) + 1;
              bool isShaded = config.useZebraShading && (idx % 2 != 0);

              return pw.Container(
                color: isShaded ? PdfColors.grey50 : PdfColors.white,
