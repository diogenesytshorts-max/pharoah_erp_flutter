                    <div class="screen-title">PARTY KHATA & LEDGER STATEMENTS</div>
                    <button class="btn btn-secondary" onclick="returnToDashboard()">← DASHBOARD</button>
                </div>

                <div class="table-wrap">
                    <table class="erp-table">
                        <thead>
                            <tr>
                                <th>DATE</th><th>PARTICULARS / REF</th><th>TYPE</th><th>DEBIT (Dr ₹)</th><th>CREDIT (Cr ₹)</th><th>RUNNING BALANCE</th>
                            </tr>
                        </thead>
                        <tbody id="ledgerTableBody"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- STOCK -->
        <section id="view-stock" style="display: none;">
            <div class="screen-panel">
                <div class="screen-header">
                    <div class="screen-title">STOCK LEDGER & LIVE INVENTORY</div>
                    <button class="btn btn-secondary" onclick="returnToDashboard()">← DASHBOARD</button>
                </div>

                <div class="table-wrap">
                    <table class="erp-table">
                        <thead>
                            <tr>
                                <th>CODE</th><th>PRODUCT NAME</th><th>PACK</th><th>BATCH</th><th>EXPIRY</th><th>MRP (₹)</th><th>PUR. RATE</th><th>RATE A</th><th>LIVE STOCK</th>
                            </tr>
                        </thead>
                        <tbody id="stockTableBody"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- MASTERS -->
        <section id="view-masters" style="display: none;">
            <div class="screen-panel" style="margin-bottom: 2rem;">
                <div class="screen-header">
                    <div class="screen-title">PRODUCT MASTER (MEDICINE REGISTRATION)</div>
                    <button class="btn btn-secondary" onclick="returnToDashboard()">← DASHBOARD</button>
                </div>

                <div class="form-grid-4">
                    <div class="form-field">
                        <label>PRODUCT NAME *</label>
                        <input type="text" id="mProdName" class="erp-input" placeholder="e.g. DOLO 650 MG">
                    </div>
                    <div class="form-field">
                        <label>PACKING *</label>
                        <input type="text" id="mProdPack" class="erp-input" placeholder="15 TAB">
                    </div>
                    <div class="form-field">
                        <label>MRP (₹) *</label>
                        <input type="number" id="mProdMrp" class="erp-input" value="50.00">
                    </div>
                    <div class="form-field">
                        <label>PURCHASE RATE (₹) *</label>
                        <input type="number" id="mProdPurRate" class="erp-input" value="38.00">
                    </div>
                </div>

                <div class="form-grid-4" style="margin-top: 1rem;">
                    <div class="form-field">
                        <label>RATE A (SALE ₹)</label>
                        <input type="number" id="mProdRateA" class="erp-input" value="45.00">
                    </div>
                    <div class="form-field">
                        <label>GST %</label>
                        <input type="number" id="mProdGst" class="erp-input" value="12">
                    </div>
                </div>

                <div style="margin-top: 1.5rem; text-align: right;">
                    <button class="btn btn-primary" onclick="saveNewProductMaster()">+ SAVE PRODUCT</button>
                </div>
            </div>

            <div class="screen-panel">
                <div class="screen-header">
                    <div class="screen-title">PARTY & LEDGER MASTER (CUSTOMER / SUPPLIER)</div>
                </div>

                <div class="form-grid-4">
                    <div class="form-field">
                        <label>PARTY / FIRM NAME *</label>
                        <input type="text" id="mPartyName" class="erp-input" placeholder="e.g. Apex Health Care">
                    </div>
                    <div class="form-field">
                        <label>ACCOUNT GROUP *</label>
                        <select id="mPartyGroup" class="erp-input">
                            <option value="Sundry Debtors">Sundry Debtors (Customer)</option>
                            <option value="Sundry Creditors">Sundry Creditors (Supplier)</option>
                            <option value="Bank Accounts">Bank Accounts</option>
                            <option value="Expenses">Expenses</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label>GSTIN (15-DIGIT)</label>
                        <input type="text" id="mPartyGst" class="erp-input" placeholder="08ABCDE1234F1Z5">
                    </div>
                    <div class="form-field">
                        <label>CITY</label>
                        <input type="text" id="mPartyCity" class="erp-input" placeholder="Udaipur">
                    </div>
                </div>

                <div class="form-grid-4" style="margin-top: 1rem;">
                    <div class="form-field">
                        <label>MOBILE NUMBER</label>
                        <input type="text" id="mPartyPhone" class="erp-input" placeholder="9876543210">
                    </div>
                    <div class="form-field">
                        <label>OPENING BALANCE (₹)</label>
                        <input type="number" id="mPartyOpBal" class="erp-input" value="0.00">
                    </div>
                </div>

                <div style="margin-top: 1.5rem; text-align: right;">
                    <button class="btn btn-success" onclick="saveNewPartyMaster()">+ SAVE PARTY MASTER</button>
                </div>
            </div>
        </section>
    </main>

    <!-- MODAL 1: PRODUCT SEARCH PICKER & QUICK ADD PRODUCT -->
    <div id="productSearchModal" class="modal-overlay">
        <div class="modal-card">
            <div class="modal-card-header">
                <h3 style="color: var(--text-light); font-size: 1.1rem;">SEARCH & SELECT PRODUCT</h3>
                <button class="btn btn-secondary" style="padding: 4px 10px;" onclick="closeProductSearchModal()">✕</button>
            </div>
            <div style="display: flex; gap: 10px; margin-top: 1rem;">
                <input type="text" id="prodLiveSearchInput" class="erp-input" placeholder="Type product name or code..." oninput="filterProductSearchList(this.value)" autofocus>
                <button class="btn btn-primary" onclick="openQuickAddProductModal()">+ NEW PRODUCT</button>
            </div>
            <div class="product-picker-list" id="productSearchListContainer"></div>
        </div>
    </div>

    <!-- MODAL: QUICK ADD PARTY (POPUP MODAL MATCHING FLUTTER APP) -->
    <div id="quickAddPartyModal" class="modal-overlay">
        <div class="modal-card" style="max-width: 520px;">
            <div class="modal-card-header">
                <h3 style="color: var(--text-light); font-size: 1.1rem;">QUICK REGISTER PARTY</h3>
                <button class="btn btn-secondary" style="padding: 4px 10px;" onclick="closeQuickAddPartyModal()">✕</button>
            </div>
            <div class="form-grid-2" style="margin-top: 1rem;">
                <div class="form-field">
                    <label>PARTY NAME *</label>
                    <input type="text" id="qpName" class="erp-input" placeholder="e.g. Apex Pharmacy">
                </div>
                <div class="form-field">
                    <label>GROUP</label>
                    <select id="qpGroup" class="erp-input">
                        <option value="Sundry Debtors">Sundry Debtors (Customer)</option>
                        <option value="Sundry Creditors">Sundry Creditors (Supplier)</option>
                    </select>
                </div>
            </div>
            <div class="form-grid-2" style="margin-top: 0.8rem;">
                <div class="form-field">
                    <label>CITY</label>
                    <input type="text" id="qpCity" class="erp-input" placeholder="e.g. Jaipur">
                </div>
                <div class="form-field">
                    <label>MOBILE</label>
                    <input type="text" id="qpPhone" class="erp-input" placeholder="9876543210">
                </div>
            </div>
            <div class="form-grid-2" style="margin-top: 0.8rem;">
                <div class="form-field">
                    <label>GSTIN</label>
                    <input type="text" id="qpGst" class="erp-input" placeholder="08ABCDE1234F1Z5">
                </div>
                <div class="form-field">
                    <label>OPENING BAL (₹)</label>
                    <input type="number" id="qpOpBal" class="erp-input" value="0.00">
                </div>
            </div>
            <div style="display: flex; justify-content: space-between; margin-top: 1.5rem;">
                <button class="btn btn-secondary" onclick="closeQuickAddPartyModal()">CANCEL</button>
                <button class="btn btn-success" onclick="saveQuickParty()">SAVE & SELECT</button>
            </div>
        </div>
    </div>

    <!-- MODAL 2: ITEM ENTRY CONFIG -->
    <div id="itemEntryModal" class="modal-overlay">
        <div class="modal-card">
            <div class="modal-card-header">
                <div>
                    <h3 id="entryModalProdTitle" style="color: var(--text-light); font-size: 1.1rem;">ITEM ENTRY</h3>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">Rate Tiers (A/B/C) & Discount Sync</div>
                </div>
                <button class="btn btn-secondary" style="padding: 4px 10px;" onclick="closeItemEntryModal()">✕</button>
            </div>

            <div class="form-grid-4" style="margin-top: 1.2rem;">
                <div class="form-field">
                    <label>BATCH (CASE-SENSITIVE)</label>
                    <input type="text" id="eBatch" class="erp-input" value="B-01">
                </div>
                <div class="form-field">
                    <label>EXPIRY (MM/YY)</label>
                    <input type="text" id="eExp" class="erp-input" value="12/28" oninput="formatExpiryField(this)">
                </div>
                <div class="form-field">
                    <label>RATE TIER</label>
                    <select id="eRateTier" class="erp-input" onchange="onRateTierChanged(this.value)">
                        <option value="A">RATE A (Standard)</option>
                        <option value="B">RATE B (Special)</option>
                        <option value="C">RATE C (Formula %)</option>
                    </select>
                </div>
                <div class="form-field">
                    <label>UNIT RATE (₹) *</label>
                    <input type="number" id="eRate" class="erp-input" value="45.00" oninput="syncDiscountInputs('percent')">
                </div>
            </div>

            <div class="form-grid-4" style="margin-top: 1rem;">
                <div class="form-field" id="eRateCDiscBox" style="display: none;">
                    <label>C FORMULA %</label>
                    <input type="number" id="eRateCDisc" class="erp-input" value="0.0" oninput="calculateRateCFormula()">
                </div>
                <div class="form-field">
                    <label>MRP (₹)</label>
                    <input type="number" id="eMrp" class="erp-input" value="50.00" oninput="calculateRateCFormula()">
                </div>
                <div class="form-field">
                    <label>BILLING QTY *</label>
                    <input type="number" id="eQty" class="erp-input" value="1" oninput="syncDiscountInputs('percent')">
                </div>
                <div class="form-field">
                    <label>FREE QTY</label>
                    <input type="number" id="eFree" class="erp-input" value="0">
                </div>
            </div>

            <div class="form-grid-2" style="margin-top: 1rem;">
                <div class="form-field">
                    <label>DISCOUNT %</label>
                    <input type="number" id="eDiscPer" class="erp-input" value="0.0" oninput="syncDiscountInputs('percent')">
                </div>
                <div class="form-field">
                    <label>DISCOUNT ₹</label>
                    <input type="number" id="eDiscAmt" class="erp-input" value="0.0" oninput="syncDiscountInputs('amount')">
                </div>
            </div>

            <div class="net-total-banner">
                <span style="font-weight: 800;">NET ITEM TOTAL:</span>
                <span id="eNetTotalDisplay" style="color: var(--accent-emerald); font-size: 1.4rem; font-weight: 900;">₹ 45.00</span>
            </div>

            <div style="display: flex; justify-content: space-between; margin-top: 1.5rem;">
                <button class="btn btn-secondary" onclick="closeItemEntryModal()">CANCEL</button>
                <button class="btn btn-success" onclick="confirmAndAddItemToCart()">CONFIRM & ADD</button>
            </div>
        </div>
    </div>

    <!-- MODAL 3: INVOICE SAVE SUCCESS -->
    <div id="billSuccessModal" class="modal-overlay">
        <div class="modal-card" style="max-width: 480px; text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 10px;">✅</div>
            <h2 id="successModalTitle" style="color: var(--accent-emerald); margin-bottom: 5px;">INVOICE SAVED!</h2>
            <p id="successModalSub" style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1.5rem;">Recorded and Synced with Google Drive.</p>

            <div style="display: flex; flex-direction: column; gap: 10px;">
                <button class="btn btn-success" style="padding: 12px;" onclick="triggerDirectPrint('A4')">📄 PRINT A4 INVOICE</button>
                <button class="btn btn-primary" style="padding: 12px;" onclick="triggerDirectPrint('Thermal')">📠 PRINT 80MM THERMAL</button>
                <button class="btn btn-secondary" style="padding: 12px;" onclick="dismissSuccessAndNewBill()">+ CREATE NEW BILL</button>
            </div>
        </div>
    </div>

    <!-- MODAL 4: DRIVE SYNC SETTINGS -->
    <div id="driveSettingsModal" class="modal-overlay">
        <div class="modal-card" style="max-width: 520px;">
            <h2 style="color: var(--accent-cyan); margin-bottom: 0.8rem; font-size: 1.2rem;">☁️ GOOGLE DRIVE CLOUD SYNC</h2>
            <p style="color: var(--text-muted); font-size: 0.82rem; margin-bottom: 1.2rem;">Configure your private Google Apps Script Webhook URL and Gmail.</p>
            <div class="form-field" style="margin-bottom: 1rem;">
                <label>GMAIL ADDRESS</label>
                <input type="email" id="driveUserEmail" class="erp-input" placeholder="yourname@gmail.com">
            </div>
            <div class="form-field" style="margin-bottom: 1.5rem;">
                <label>APPS SCRIPT WEBHOOK URL</label>
                <input type="text" id="driveApiUrl" class="erp-input" placeholder="https://script.google.com/macros/s/.../exec">
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 1rem;">
                <button class="btn btn-danger-sm" onclick="closeDriveSettings()">CANCEL</button>
                <button class="btn btn-success" onclick="saveDriveSettingsFromModal()">CONNECT & SYNC</button>
            </div>
            <div style="border-top: 1px solid var(--border-color); padding-top: 1rem; text-align: center;">
                <button class="btn btn-danger-sm" style="width: 100%; padding: 8px;" onclick="hardResetAllLocalData()">🧹 RESET LOCAL DATA</button>
            </div>
        </div>
    </div>

    <!-- MODAL 5: USER GUIDE -->
    <div id="guideModal" class="modal-overlay">
        <div class="modal-card" style="max-width: 550px;">
            <h2 style="color: var(--accent-cyan); margin-bottom: 1rem; font-size: 1.2rem;">📖 PHAROAH ERP - USER MANUAL</h2>
            <div style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.6; display: flex; flex-direction: column; gap: 10px;">
                <p><strong>1. Step 1 & Step 2 Billing:</strong> Step 1 configures series, date, and customer. Step 2 opens the live billing cart with A/B/C rate tiers, formulas, and auto round-off.</p>
                <p><strong>2. 2-Way Live Sync:</strong> All transactions saved on the web are synchronized with your personal Google Drive and automatically downloaded to your mobile app.</p>
                <p><strong>3. Multi-Tenant Privacy:</strong> Each user has their own private Google Drive storage. No data mixing across different businesses.</p>
            </div>
            <div style="margin-top: 1.5rem; text-align: right;">
                <button class="btn btn-primary" onclick="closeGuideModal()">GOT IT</button>
            </div>
        </div>
    </div>

    <datalist id="partyDatalist"></datalist>
    <datalist id="itemDatalist"></datalist>
    <div id="printArea" class="print-area"></div>

    <script src="drive_sync.js?v=9.0"></script>
    <script src="app_engine.js?v=9.0"></script>
    <script src="app_ui.js?v=9.0"></script>
</body>
</html>
