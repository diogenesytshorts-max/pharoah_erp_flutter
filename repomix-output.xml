              _tCol("Batch", 70), _tCol("Exp", 45), _tCol("HSN", 45), _tCol("MRP", 55), _tCol("Rate", 55), 
              _tCol("CGST", 40), _tCol("SGST", 40), _tCol("Total", 125, isLast: true), 
            ])),
